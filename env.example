# Discord Bot Token
# Get this from https://discord.com/developers/applications
# Create a new application, go to Bot section, and copy the token
DISCORD_TOKEN=your_bot_token_here

# Discord Client ID (Application ID)
# Found in the General Information section of your Discord application
DISCORD_CLIENT_ID=your_client_id_here

# Discord Client Secret (for OAuth)
# Found in the OAuth2 section of your Discord application
DISCORD_CLIENT_SECRET=your_client_secret_here

# OAuth Callback URL (should match your OAuth redirect URI in Discord Developer Portal)
# For local development: http://localhost:3000/auth/discord/callback
# For production: https://yourdomain.com/auth/discord/callback
OAUTH_CALLBACK_URL=http://localhost:3000/auth/discord/callback

# Session Secret (generate a random string for session encryption)
SESSION_SECRET=your_random_session_secret_here

# Webhook Server Port (optional, defaults to 3000)
PORT=3000

# Webhook Base URL (optional, defaults to http://localhost:PORT)
# Set this to your public URL in production (e.g., https://yourdomain.com)
WEBHOOK_BASE_URL=http://localhost:3000

# Storage Configuration
# Storage type: 'file' or 'postgres'/'postgresql' (default: 'file')
STORAGE_TYPE=file

# File Storage Configuration (used when STORAGE_TYPE=file)
# Path to the JSON file where channels will be stored (default: ./data/channels.json)
STORAGE_FILE=./data/channels.json

# PostgreSQL Storage Configuration (used when STORAGE_TYPE=postgres or postgresql)
# PostgreSQL connection string (e.g., postgresql://user:password@localhost:5432/dbname)
DATABASE_URL=postgresql://user:password@localhost:5432/printerbot
# Enable SSL for database connection (set to 'true' if your database requires SSL)
DATABASE_SSL=false



